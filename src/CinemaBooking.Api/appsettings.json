{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=(localdb)\\MSSQLLocalDB;Database=CinemaBooking;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CinemaBooking",
    "Audience": "CinemaBooking",
    "Key": "CHANGE_ME_USE_USER_SECRETS_OR_ENV_32_CHARS_MIN",
    "ExpirationMinutes": 15
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ReturnUrl": "http://localhost:8081/payments/return",
    "CancelUrl": "http://localhost:8081/payments/cancel",
    "ExpirationMinutes": 15
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "MovieImport": {
    "Enabled": false,
    "RunOnDay": 1,
    "RunAtHour": 3,
    "RequestDelayMs": 1500,
    "MaxMovies": 40,
    "UserAgent": "CinemaBookingBot/1.0 (+local-dev)",
    "Moveek": {
      "BaseUrl": "https://moveek.com",
      "ListingPaths": [
        "/phim-dang-chieu/",
        "/phim-sap-chieu/"
      ]
    }
  },
  "Email": {
    "Provider": "Logging",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "Cinema Booking"
    }
  }
}
