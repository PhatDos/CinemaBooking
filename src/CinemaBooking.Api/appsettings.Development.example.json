{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=YOUR_SQL_SERVER;Database=CinemaBooking;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Jwt": {
    "Issuer": "CinemaBooking",
    "Audience": "CinemaBooking",
    "Key": "YOUR_LOCAL_JWT_KEY_AT_LEAST_32_CHARACTERS",
    "ExpirationMinutes": 15
  },
  "AdminSeed": {
    "Email": "admin@cinema.com",
    "Password": "CHANGE_ME_LOCAL_ADMIN_PASSWORD"
  },
  "StaffSeed": {
    "Email": "staff@cinema.com",
    "Password": "CHANGE_ME_LOCAL_STAFF_PASSWORD"
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "ReturnUrl": "http://localhost:8081/payments/return",
    "CancelUrl": "http://localhost:8081/payments/cancel"
  },
  "Email": {
    "Provider": "Logging",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "YOUR_SMTP_USERNAME",
      "Password": "YOUR_SMTP_APP_PASSWORD",
      "FromEmail": "YOUR_FROM_EMAIL",
      "FromName": "Cinema Booking"
    }
  }
}
